# =====================================================
# Configuración de la API de Prueba Técnica
# Copia este archivo como `.env` y ajusta los valores.
#   cp .env.example .env
# =====================================================

# Servidor
NODE_ENV=development
PORT=3000

# API
API_PREFIX=api

# Swagger (documentación de la API)
SWAGGER_ENABLED=true
SWAGGER_TITLE=API de Prueba Técnica
SWAGGER_DESCRIPTION=Documentación de la API en español
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=prueba
DB_PASSWORD=prueba
DB_DATABASE=prueba_tecnica

# Almacenamiento de archivos (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documentos

# Extracción con IA (opcional). Si no se define OPENAI_API_KEY,
# la extracción usa únicamente reglas y expresiones regulares.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
