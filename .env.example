# =====================================================
# Configuración de la API de Prueba Técnica
# Copia este archivo como `.env` y ajusta los valores.
#   cp .env.example .env
# =====================================================

# Servidor
NODE_ENV=development
PORT=3000

# API
API_PREFIX=api

# Swagger (documentación de la API)
SWAGGER_ENABLED=true
SWAGGER_TITLE=API de Prueba Técnica
SWAGGER_DESCRIPTION=Documentación de la API en español
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=prueba
DB_PASSWORD=prueba
DB_DATABASE=prueba_tecnica

# JWT (¡cambia el secreto en entornos reales!)
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=1h
