# =====================================================
# Configuración de la API de Prueba Técnica
# Copia este archivo como `.env` y ajusta los valores.
#   cp .env.example .env
# =====================================================

# Servidor
NODE_ENV=development
PORT=3000

# API
API_PREFIX=api

# Swagger (documentación de la API)
SWAGGER_ENABLED=true
SWAGGER_TITLE=API de Prueba Técnica
SWAGGER_DESCRIPTION=Documentación de la API en español
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=prueba
DB_PASSWORD=prueba
DB_DATABASE=prueba_tecnica

# Almacenamiento de archivos (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documentos

# Extracción con IA (opcional). Compatible con OpenAI, DeepSeek y cualquier
# proveedor que exponga una API estilo OpenAI.
# Si LLM_API_KEY está vacío, la extracción usa únicamente reglas y regex.
# - DeepSeek:   LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
# - OpenAI:     LLM_BASE_URL= (vacío)                  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Extracción por VISIÓN (opcional, recomendado para documentos escritos a mano).
# Lee la imagen directamente con Google Gemini y extrae fechas manuscritas, etc.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ruta local de los modelos de idioma de Tesseract (opcional).
# En Docker se usa /tessdata (pre-descargados en la imagen). Déjalo vacío en local.
TESSDATA_PATH=
